# Copy to .env (which is gitignored) and set your key. Never commit the real key.
# Only used at INFERENCE time for the single nemotron-parse call. Not used in training.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: override the local Nemotron checkpoint path. By default the code looks
# for the checkpoint at  v1/Nemotron-Mini-4B-Instruct/  (not committed, ~16GB).
# FEDNEMO_MODEL_PATH=E:\FedNeMo\v1\Nemotron-Mini-4B-Instruct
